<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout style="@style/Card">

            <Button
                android:id="@+id/buttonCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_check" />

            <TextView
                android:id="@+id/textUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonBrowser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/about_download_browser" />

            <TextView
                style="@style/BodyText"
                android:text="@string/about_browser_hint" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <Button
                android:id="@+id/buttonInstallFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_install_file" />

            <TextView
                style="@style/BodyText"
                android:text="@string/about_install_file_hint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardSupport"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/about_support_title" />

            <Button
                android:id="@+id/buttonSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/about_support" />

            <Button
                android:id="@+id/buttonProject"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/about_project" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/about_privacy_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/about_privacy" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
